<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: two columns. Hours and minutes stacked big on the left, a thin amber rule, then the
     day's details on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nightstandRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/nightstandContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: hours over minutes -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/nightstandClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:textColor="#FFFFC66B"
                android:textSize="150sp"
                android:fontFamily="@font/outfit"
                android:lineSpacingMultiplier="0.8"
                android:includeFontPadding="false" />

            <TextClock
                android:id="@+id/nightstandMinute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-18dp"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:textColor="#FFF5E1BC"
                android:textSize="150sp"
                android:fontFamily="@font/outfit"
                android:includeFontPadding="false" />

            <TextClock
                android:id="@+id/nightstandAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#CCFFC66B"
                android:textSize="20sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.3"
                android:textAllCaps="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- The rule between the two columns -->
        <View
            android:layout_width="2dp"
            android:layout_height="260dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:background="#55FFC66B" />

        <!-- Right: the day -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/nightstandDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:textAllCaps="true"
                android:textColor="#E6F5E1BC"
                android:textSize="30sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.18"
                android:includeFontPadding="false" />

            <TextClock
                android:id="@+id/nightstandDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:format12Hour="d MMMM yyyy"
                android:format24Hour="d MMMM yyyy"
                android:textColor="#B3F5E1BC"
                android:textSize="18sp"
                android:fontFamily="@font/instrument_sans"
                android:letterSpacing="0.04"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nightstandHijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D9E8B87A"
                android:textSize="16sp"
                android:fontFamily="@font/instrument_sans"
                android:letterSpacing="0.04"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nightstandWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                android:textColor="#E6F5E1BC"
                android:textSize="20sp"
                android:fontFamily="@font/instrument_sans"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nightstandPrayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:background="@drawable/pill_amber"
                android:textColor="#FFFFE2A8"
                android:textSize="15sp"
                android:fontFamily="@font/instrument_sans"
                android:letterSpacing="0.03"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nightstandAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                android:lineSpacingExtra="4dp"
                android:textColor="#E6F5E1BC"
                android:textSize="16sp"
                android:fontFamily="@font/instrument_sans"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/nightstandHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="PRESS ANY BUTTON TO RETURN"
                android:textColor="#4DFFC66B"
                android:textSize="11sp"
                android:fontFamily="@font/instrument_sans"
                android:letterSpacing="0.2"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
