<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nightstandRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/nightstandContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Gregorian Date -->
        <TextClock
            android:id="@+id/nightstandDate"
            android:textAllCaps="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:format12Hour="EEEE  ·  d MMM yyyy"
            android:format24Hour="EEEE  ·  d MMM yyyy"
            android:textColor="#E6F5E1BC"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.28"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:includeFontPadding="false" />

        <!-- StandBy Clock Display -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/nightstandClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFC66B"
                android:textSize="128sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="-0.02"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10"
                android:includeFontPadding="false" />

            <TextClock
                android:id="@+id/nightstandAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="26dp"
                android:layout_gravity="bottom"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#CCFFC66B"
                android:textSize="22sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Islamic Hijri Date -->
        <TextView
            android:id="@+id/nightstandHijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#D9E8B87A"
            android:textSize="16sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.06"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:includeFontPadding="false" />

        <!-- Weather line (temperature and sky) -->
        <TextView
            android:id="@+id/nightstandWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:textColor="#E6F5E1BC"
            android:textSize="18sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.04"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:includeFontPadding="false" />

        <!-- Next Prayer Time Capsule -->
        <TextView
            android:id="@+id/nightstandPrayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/pill_amber"
            android:textColor="#FFFFC66B"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.05"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:includeFontPadding="false" />

        <!-- Today's calendar -->
        <TextView
            android:id="@+id/nightstandAgenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#E6F5E1BC"
            android:textSize="16sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 450"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:includeFontPadding="false" />

        <!-- Dim return hint -->
        <TextView
            android:id="@+id/nightstandHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="PRESS ANY BUTTON TO RETURN"
            android:textColor="#4DFFC66B"
            android:textSize="11sp"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.2"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
