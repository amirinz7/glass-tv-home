<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for the top-bar pills; MainActivity swaps in GlassDrawable, which adds live blur.
     ReactDrops Soap Bubble style: translucent liquid glass with thin-film iridescent rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#B318120D"
                android:endColor="#D90F0B08" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#141B140E" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
