<?xml version="1.0" encoding="utf-8"?>
<!-- ReactDrops Soap Bubble styled floating dock tray -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#400A101D"
                android:centerColor="#26121B2A"
                android:endColor="#400A101D" />
            <corners android:radius="17dp" />
            <stroke android:width="1.2dp" android:color="#40FFC66B" />
        </shape>
    </item>
    <item android:bottom="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00000000" />
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
        </shape>
    </item>
</layer-list>
